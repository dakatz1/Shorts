# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Script generation ---
# Used when providers.llm = "anthropic"
ANTHROPIC_API_KEY=

# --- Voiceover ---
# Used when providers.tts = "elevenlabs"
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Images / animation frames ---
# Used when providers.image = "replicate"
REPLICATE_API_TOKEN=
# Used when providers.image = "openai"
OPENAI_API_KEY=

# --- YouTube upload ---
# Path to the OAuth client secret you download from Google Cloud Console
YOUTUBE_CLIENT_SECRET=client_secret.json
# Where the refresh token gets cached after the first browser consent
YOUTUBE_TOKEN_FILE=youtube_token.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Secrets — never commit these
.env
*.client_secret.json
client_secret*.json
token*.json
youtube_token.json

# Generated media & scratch
out/
cache/
release/

# B-roll and music are yours to supply. Declaring them in sources.txt keeps the
# repo small, but committing clips directly also works (and is the easiest way
# to add them from a phone) — git only ignores them here if you add them locally.
assets/broll/*
!assets/broll/README.md
!assets/broll/sources.txt
!assets/broll/.gitkeep
assets/music/*
!assets/music/README.md
!assets/music/.gitkeep
assets/fonts/*.ttf
assets/fonts/*.otf

# OS
.DS_Store
